<?xml version="1.0" encoding="utf-8"?>
<!--
  AND-14: this file used to be the stock Android Studio teal grid left over
  from project generation. Nothing referenced it, and anyone opening the icon
  resources saw an unfinished-looking placeholder.

  It is now the real adaptive-icon background: the brand ink, lifted by a
  diagonal wash so the gilt frame in the foreground reads against depth rather
  than a flat block. The full 108x108 is painted because the launcher parallaxes
  the background behind the mask.
-->
<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FF1E2418" />
                <item android:offset="0.55" android:color="#FF11140F" />
                <item android:offset="1" android:color="#FF070905" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
