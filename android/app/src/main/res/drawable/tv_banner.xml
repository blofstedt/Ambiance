<?xml version="1.0" encoding="utf-8"?>
<!--
  AND-14: the Android TV home-row banner.

  This was a <layer-list> that inset the 108dp square launcher icon by 90dp on
  the left and right. Inset values are applied to the *container* bounds, so on
  a 320x180dp banner the square mark was squeezed into a 140x120dp box and
  stretched non-uniformly to fill it — the icon appeared visibly distorted on
  the home screen, with no app name anywhere on it.

  It is now a real 320x180 banner: the framed-canvas mark at true aspect ratio,
  a hairline rule, and the wordmark set in a serif to match the app's own
  overlay typography. Letterforms are committed as outlines so the banner needs
  no font at runtime and stays a text file, not a binary.
-->
<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <path android:pathData="M0,0h320v180h-320z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="320" android:endY="180">
                <item android:offset="0" android:color="#FF20261A" />
                <item android:offset="0.5" android:color="#FF11140F" />
                <item android:offset="1" android:color="#FF070905" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Warm light spilling from the picture, so the mark sits in the scene. -->
    <path android:pathData="M0,0h200v180h-200z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="64" android:centerY="90"
                android:gradientRadius="86">
                <item android:offset="0" android:color="#2ED4CDA4" />
                <item android:offset="0.6" android:color="#12D4CDA4" />
                <item android:offset="1" android:color="#00D4CDA4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The launcher mark, at 1.5x and true aspect, centred on (64,90). -->
    <group
        android:scaleX="1.5" android:scaleY="1.5"
        android:translateX="-17" android:translateY="9">
        <path android:pathData="M32,37h44v34h-44z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54" android:startY="37"
                    android:endX="54" android:endY="71">
                    <item android:offset="0" android:color="#FFF4ECC8" />
                    <item android:offset="0.5" android:color="#FFD8D1A2" />
                    <item android:offset="1" android:color="#FFA7B187" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:fillColor="#30FFF3CE"
            android:pathData="M64,46.5m-8.6,0a8.6,8.6 0,1 1,17.2 0a8.6,8.6 0,1 1,-17.2 0" />
        <path
            android:fillColor="#FFFFFBEC"
            android:pathData="M64,46.5m-4.4,0a4.4,4.4 0,1 1,8.8 0a4.4,4.4 0,1 1,-8.8 0" />
        <path
            android:fillColor="#FF6B7A52"
            android:pathData="M32,61.5C39,57.2 45.5,60.4 52,58.4C59.5,56.1 66,58.8 76,55.6L76,71L32,71Z" />
        <path
            android:fillColor="#FF3E4A31"
            android:pathData="M32,66C40,62.5 48,65.5 57,63.8C65,62.3 70,64.5 76,63L76,71L32,71Z" />
        <path
            android:pathData="M32,37h44v34h-44z"
            android:fillColor="#00000000"
            android:strokeWidth="4.5"
            android:strokeLineJoin="miter">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="30" android:startY="35"
                    android:endX="78" android:endY="73">
                    <item android:offset="0" android:color="#FFE0D49B" />
                    <item android:offset="0.55" android:color="#FFC1B87E" />
                    <item android:offset="1" android:color="#FF837D4F" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Hairline rule separating mark from wordmark. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M110,58L110,122"
        android:strokeColor="#59D4CDA4"
        android:strokeWidth="1" />

