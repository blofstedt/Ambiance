<?xml version="1.0" encoding="utf-8"?>
<!--
  AND-08: the previous config ended with
      <base-config cleartextTrafficPermitted="true" />
  which re-enabled plaintext HTTP for the ENTIRE app, including the Unsplash /
  Open-Meteo / BigDataCloud calls, and made the domain-config above it
  pointless. The <domain>local</domain> entry was also wrong: it matches the
  hostname "local", not the ".local" mDNS suffix.

  Cleartext is now permitted only for RFC1918 / link-local addresses and the
  mDNS suffix the sensor actually advertises. Everything else is HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- mDNS: the sensor registers as ambient-<mac>.local -->
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="true">localhost</domain>

        <!-- Private LAN ranges where an ESP32 sensor can live -->
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <!-- SoftAP pairing mode -->
        <domain includeSubdomains="true">192.168.4.1</domain>
    </domain-config>
</network-security-config>
