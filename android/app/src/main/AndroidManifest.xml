<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- AND-04: an always-on ambient art display must be able to hold the
         screen awake. Without this the TV dimmed and slept on its own timer,
         which defeats the entire purpose of the app. The actual FLAG_KEEP_
         SCREEN_ON is applied at runtime and is user-toggleable (see
         MainActivity + the "Keep Screen Awake" setting). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Required for mDNS / NSD discovery of the ambient sensor (WEB-04). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- AND-11: over-the-air updates. This does NOT let the app install
         anything on its own — Android still shows its own installer and the
         user still confirms. Without the permission that installer closes
         instantly with no message, which on a TV looks like a crash. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- AND-17: the screensaver escape hatch, for TVs whose settings UI refuses
         to list third-party screensavers.

         Several Google TV models only ever offer Google's own ambient screen.
         That restriction lives in the Settings UI, not in DreamManagerService,
         which still honours the screensaver_* Secure keys — so with this
         permission held the app can select itself and the screensaver works on
         those devices too.

         This permission is NOT granted by installing the app and cannot be
         requested at runtime. It carries the framework's `development`
         protection flag, which means only the owner of the device can turn it
         on, deliberately, from a computer over adb. It has to be declared here
         for that to be possible at all — an undeclared permission cannot be
         granted. Until the owner does so, holdsWriteSecureSettings() is false,
         nothing is written, and the app just points at the system picker. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- AND-08: android:usesCleartextTraffic="true" was removed. It is
             redundant alongside networkSecurityConfig and, being the broader
             of the two, it silently overrode the per-domain rules. Cleartext
             is now permitted ONLY for the local sensor, in
             network_security_config.xml. -->

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AmbientDreamService"
            android:exported="true"
            android:label="@string/ambient_dream_title"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <!-- AND-16: the platform's own dream picker queries with a bare
                     action, but several TV launchers and OEM settings apps add
                     CATEGORY_DEFAULT to that query. Without it this service is
                     simply absent from their screensaver list. -->
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/ambient_dream" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

</manifest>
