# Ambient Canvas environment
#
# BUILD-04: there is intentionally NO API key here any more. The previous
# vite.config.ts inlined GEMINI_API_KEY into the client bundle shipped inside
# the APK, where it is trivially extractable. No source file ever read it.
#
# Never add a secret to this file expecting Vite to keep it private. Anything
# Vite can see ends up in the bundle.

# Port for the optional production static server (npm run serve)
PORT=3000
